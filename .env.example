# ─── Server ──────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ─── WhatsApp bot ────────────────────────────────────────
# Phone number used to pair the bot, including country code, no plus sign.
# Example: 15551234567
BOT_PHONE_NUMBER=

# Owner number that receives forwarded view-once / status media.
# Same format as above.
OWNER_NUMBER=

# Default command prefix
PREFIX=*

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
